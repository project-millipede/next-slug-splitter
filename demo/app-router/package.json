{
  "name": "next-slug-splitter-demo-app-router",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rimraf dist && rimraf .next",
    "generate:ballast": "pnpm --filter @next-slug-splitter/ballast-kit generate",
    "clean:handlers": "node scripts/clean-handlers.mjs",
    "clean:all": "node scripts/erase-generated-dev-state.mjs",
    "dev": "pnpm generate:ballast && next dev",
    "dev:ts": "pnpm generate:ballast && next dev",
    "build": "pnpm generate:ballast && pnpm clean:handlers && next build",
    "build:ts": "pnpm generate:ballast && pnpm clean:handlers && next build",
    "start": "next start",
    "start:ts": "next start",
    "analyze:turbo": "pnpm next experimental-analyze"
  },
  "dependencies": {
    "@next-slug-splitter/ballast-kit": "workspace:*",
    "@fal-works/esbuild-plugin-global-externals": "^2.1.2",
    "@mdx-js/esbuild": "^3.1.1",
    "esbuild": "^0.28.1",
    "next": "^16.3.0",
    "next-slug-splitter": "file:../..",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2"
  }
}
